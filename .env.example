DATABASE_URL=
DIRECT_URL=
DOSSIER_USER_COUNT_FLOOR=0

# Managed "Dossier AI" tier (server-only; never expose model slugs to the client).
# OpenRouter serves the free models; do the one-time $10 lifetime top-up to unlock
# 1000 free-model requests/day (the cap is account-wide, shared across all users).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional override for the paid fallback model (defaults to gpt-4o-mini).
MANAGED_AI_FALLBACK_MODEL=

# Stripe credit purchases via Checkout Sessions (no accounts; wallet token rides as
# client_reference_id + session metadata). Use a restricted key (rk_) in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs per credit bundle (created via the Stripe API; £1/10, £2.50/30, £5/70).
STRIPE_PRICE_SMALL=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_LARGE=
